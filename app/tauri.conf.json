{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WestPlay",
  "version": "3.0.1",
  "identifier": "app.westplay",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../ui/dist",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../ui",
      "wait": false
    },
    "beforeBuildCommand": "echo using the pre-built UI from the official installer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WestPlay CN Vision",
        "width": 900,
        "height": 600,
        "resizable": false,
        "maximizable": false,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows --autoplay-policy=no-user-gesture-required",
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "WestPlay CN Vision",
    "copyright": "Copyright © 2026 WestPlay. Licensed under the GPL-3.0-or-later.",
    "category": "Game",
    "shortDescription": "WestPlay CN Vision",
    "longDescription": "WestPlay puts a CarPlay-style screen in your truck in Euro Truck Simulator 2: a map made from your own game, music from Apple Music, Spotify and YouTube Music, YouTube, and your game's route, on the truck's own screen.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../ui/dist/": "ui/",
      "../assets/westplay.scs": "westplay.scs",
      "../netease-layer/": "netease-layer/"
    },
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGNTMxMkFDRTExQjQzNUUKUldSZVF4dmhyQkpUVDQ4cjQ2ZXpIaVVtZkxsR2RCaERYbDlXQlU2RkNKYWVXRTRWMVVPbUY3a2oK",
      "endpoints": [
        "https://github.com/jtllcsj/WestPlay-CN-Vision/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
